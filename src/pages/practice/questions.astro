---
import Base from '../../layouts/Base.astro';
import { QUESTIONS } from '../../data/practice';
import { questionHTML } from '../../lib/qhtml';
import { allQuestions } from '../../data/practice';

const BASE = import.meta.env.BASE_URL;
const questions = allQuestions();
---

<Base title="question bank" active="practice" wide>
  <h1>graded question bank</h1>
  <p class="lede">
    {questions.length} questions, ordered basic → JEE Main → JEE Advanced. every question has three hints, then the full
    checked solution.
  </p>

  <div class="q-list" data-q-list>
    {questions.map((q) => questionHTML(q, { showTopic: true })).join('\n')}
  </div>

  <script>
    import { initPractice } from '../../lib/practice-ui';
    initPractice(document);
  </script>
</Base>